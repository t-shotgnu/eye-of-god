# Export these variables in your shell; the app does not auto-load .env files.
# Alternatively, use the Settings page (local ignored .data/settings.json).
PRICK_DEMO=false
PRICK_AZURE_ORGANIZATION=my-organization
PRICK_AZURE_PROJECT=my-project
PRICK_AZURE_REPOSITORY=my-repository
PRICK_AZURE_PAT=
PRICK_PROVIDER=openai
PRICK_MODEL=
PRICK_API_KEY=
# For PRICK_PROVIDER=compatible (including local models):
PRICK_API_BASE=http://localhost:11434/v1
# For PRICK_PROVIDER=copilot, optional when the Copilot CLI is already authenticated:
PRICK_COPILOT_TOKEN=
